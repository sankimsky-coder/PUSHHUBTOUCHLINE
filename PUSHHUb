-- ================= ENGINE CORE LOOPS =================
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    -- 1. DYNAMIC HITBOX LOGIC
    if State.Hitbox.Enabled then
        pcall(function()
            sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
            sethiddenproperty(LocalPlayer, "MaxSimulationRadius", math.huge)
        end)

        if State.Hitbox.Target == "Ball" then
            for ball, _ in pairs(ActiveBalls) do
                if ball and ball.Parent then
                    ExpandHitbox(ball, hrp)
                end
            end
        end
    end

    -- 2. ESP LOGIC
    for ball, _ in pairs(ActiveBalls) do
        if not BallESP[ball] then
            BallESP[ball] = { Circle = Drawing.new("Circle"), Text = Drawing.new("Text") }
            BallESP[ball].Circle.Thickness = 2
            BallESP[ball].Circle.Filled = false
            BallESP[ball].Circle.Color = Color3.fromRGB(255, 120, 0)
            BallESP[ball].Text.Center = true
            BallESP[ball].Text.Size = 16
            BallESP[ball].Text.Outline = true
            BallESP[ball].Text.Color = Color3.fromRGB(255, 255, 255)
        end

        if State.ESP.BallCircle and ball and ball.Parent then
            local pos, onScreen = Camera:WorldToViewportPoint(ball.Position)
            if onScreen then
                BallESP[ball].Circle.Visible = true
                BallESP[ball].Circle.Position = Vector2.new(pos.X, pos.Y)
                local dist = (Camera.CFrame.Position - ball.Position).Magnitude
                BallESP[ball].Circle.Radius = math.clamp(1000 / dist, 5, 100)
                
                if State.ESP.Speed then
                    BallESP[ball].Text.Visible = true
                    BallESP[ball].Text.Position = Vector2.new(pos.X, pos.Y - 20)
                    BallESP[ball].Text.Text = "Spd: " .. math.floor(ball.AssemblyLinearVelocity.Magnitude)
                else
                    BallESP[ball].Text.Visible = false
                end
            else
                BallESP[ball].Circle.Visible = false; BallESP[ball].Text.Visible = false
            end
        else
            BallESP[ball].Circle.Visible = false; BallESP[ball].Text.Visible = false
        end
    end
    
    -- 3. PING & MS UI
    if State.ESP.PingBox then
        pcall(function() PingText.Text = "Ping: " .. tostring(math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())) .. " ms" end)
    end
end)

